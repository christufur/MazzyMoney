# Copy to .env, fill in the blanks, then `chmod 600 .env`.
# Every value below is a placeholder. Never commit the real .env.

# --- Database ---------------------------------------------------------------
# Compose uses these for the Postgres container and to build the app's
# DATABASE_URL. Pick a long random password; it never leaves the host.
POSTGRES_USER=mazzy
POSTGRES_PASSWORD=change-me-use-a-long-random-password

# --- App secrets ------------------------------------------------------------
# Signs login tokens. Changing it logs everyone out.
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-openssl-rand-hex-32
# How long a login lasts.
JWT_EXPIRES_IN=30d
# Unlocks POST /api/admin/sync-all. Leave it empty to keep that endpoint off.
# Generate with: openssl rand -hex 32
ADMIN_API_KEY=change-me-openssl-rand-hex-32
# The first account registers without a code; everyone after needs this one.
# Generate with: openssl rand -hex 16
INVITE_CODE=change-me-openssl-rand-hex-16

# --- Plaid ------------------------------------------------------------------
# Dashboard: https://dashboard.plaid.com/team/keys
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-secret
# sandbox, development, or production. Use sandbox until the app is working.
PLAID_ENV=production

# --- Server -----------------------------------------------------------------
PORT=8000

# --- Notifications (ntfy) ---------------------------------------------------
# Where the app posts pushes. Inside compose the ntfy service answers on http://ntfy:80;
# leave it empty to turn notifications off entirely (the Settings page says so).
NTFY_URL=http://ntfy:80
# The public URL of this app, used for the links inside a push.
# https://<machine>.<tailnet>.ts.net
APP_URL=
# The household's clock: the weekly recap's Sunday 17:00 and the day balance snapshots
# are filed under. IANA name, e.g. America/Denver.
APP_TIMEZONE=America/Denver
